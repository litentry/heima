{
    "name": "@heima-network/stress-tests",
    "version": "1.0.0",
    "description": "Advanced QPS stress testing tool for Omni Executor with comprehensive analysis",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "stress": "tsx src/stress-test.ts",
        "dashboard": "cd src/dashboard && pnpm run dev",
        "dashboard:install": "cd src/dashboard && pnpm install",
        "dashboard:build": "cd src/dashboard && pnpm run build && pnpm run start",
        "clean": "rm -rf dist stress-test-results",
        "lint": "eslint src/**/*.ts",
        "format": "prettier --write src/**/*.ts",
        "test-connectivity": "tsx -e \"import('./src/advanced-stress-test.js').then(m => new m.AdvancedStressTest().testConnectivity())\""
    },
    "dependencies": {
        "@polkadot/api": "^16.5.4",
        "@polkadot/util": "^14.0.2",
        "ajv": "^8.20.0",
        "chalk": "^6.0.0",
        "chart.js": "^4.4.1",
        "chartjs-adapter-date-fns": "^3.0.0",
        "commander": "^15.0.0",
        "date-fns": "^4.4.0",
        "dotenv": "^17.4.2",
        "exceljs": "^4.4.0",
        "express": "^5.2.1",
        "js-sha256": "^1.0.0",
        "ora": "^9.4.1",
        "pidusage": "^4.0.1",
        "systeminformation": "^5.33.5",
        "table": "^6.8.1",
        "viem": "^2.56.0",
        "ws": "^8.21.3"
    },
    "devDependencies": {
        "@types/chai": "^5.2.3",
        "@types/express": "^5.0.6",
        "@types/mocha": "^10.0.7",
        "@types/node": "^20.14.11",
        "@types/pidusage": "^2.0.5",
        "@types/ws": "^8.5.12",
        "chai": "^6.2.2",
        "eslint": "^10.9.1",
        "mocha": "^11.8.0",
        "prettier": "^3.3.2",
        "tsx": "^4.16.2",
        "typescript": "^5.5.3"
    },
    "keywords": [
        "stress-test",
        "performance",
        "omni-executor",
        "heima-network"
    ],
    "author": "Heima Network",
    "license": "MIT"
}
