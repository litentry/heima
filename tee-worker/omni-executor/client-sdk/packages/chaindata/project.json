{
  "name": "chaindata",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/chaindata/src",
  "projectType": "library",
  "targets": {
    "build": {
      "outputs": ["{options.outDir}"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "./packages/chaindata",
        "command": "npx tsup",
        "assets": ["packages/chaindata/*.md"],
        "outDir": "dist"
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs chaindata {args.tag}",
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "cwd": "./packages/chaindata",
        "command": "ESLINT_USE_FLAT_CONFIG=false eslint src/**/*.ts package.json"
      }
    }
  },
  "tags": []
}

      