{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["jest", "node"],
    "baseUrl": "./",
    "paths": {
      "@lib/*": [
        "src/lib/*"
      ],
      "@requests/*": [
        "src/lib/requests/*"
      ],
      "@type-creators/*": [
        "src/lib/type-creators/*"
      ],
      "@utils/*": [
        "src/lib/utils/*"
      ],
      "@test-utils/*": [
        "src/lib/test-utils/*"
      ]
    }
  },
  "include": [
    "jest.config.ts",
    "src/lib/test-utils/*",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
