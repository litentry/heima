{
  "name": "client-sdk",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/client-sdk/src",
  "projectType": "library",
  "targets": {
    "publish": {
      "command": "node tools/scripts/publish.mjs client-sdk {args.tag}",
      "dependsOn": ["build"]
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{options.outDir}"],
      "options": {
        "cwd": "./packages/client-sdk",
        "command": "npx tsup",
        "assets": ["packages/client-sdk/*.md", "packages/client-sdk/LICENSE"],
        "outDir": "dist"
      }
    },
    "generate-doc": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "./packages/client-sdk",
        "command": "typedoc --options ./typedoc.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "outputs": ["{options.outputFile}"],
      "options": {
        "cwd": "./packages/client-sdk",
        "command": "ESLINT_USE_FLAT_CONFIG=false eslint src/**/*.ts package.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/client-sdk/jest.config.ts",
        "passWithNoTests": true,
        "silent": false,
        "testTimeout": 600000
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  },
  "tags": []
}
