{
  "extends": ["../../.eslintrc.json"],
  "ignorePatterns": ["!**/*"],
  "overrides": [
    {
      "files": ["*.ts", "*.js"],
      "rules": {
        "@typescript-eslint/no-unused-vars": [
          "error",
          {
            "varsIgnorePattern": "^_",
            "argsIgnorePattern": "^_",
            "caughtErrorsIgnorePattern": "^_"
          }
        ]
      }
    },
    {
      "files": ["*.json"],
      "parser": "jsonc-eslint-parser",
      "rules": {
        "@nx/dependency-checks": [
          "error",
          {
            "ignoredDependencies": [
              "@heima/chaindata",
              "@heima/parachain-api",
              "@polkadot/api",
              "@polkadot/types",
              "@polkadot/types-codec",
              "@polkadot/util",
              "@polkadot/util-crypto",
              "@scure/base",
              "isomorphic-ws",
              "tslib",
              "ws"
            ]
          }
        ]
      }
    }
  ]
}
