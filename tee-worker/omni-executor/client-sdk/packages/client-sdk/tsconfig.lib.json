{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "types": ["node"],
    "baseUrl": "./",
    "paths": {
      "@lib/*": [
        "src/lib/*"
      ],
      "@requests/*": [
        "src/lib/requests/*"
      ],
      "@type-creators/*": [
        "src/lib/type-creators/*"
      ],
      "@utils/*": [
        "src/lib/utils/*"
      ]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
