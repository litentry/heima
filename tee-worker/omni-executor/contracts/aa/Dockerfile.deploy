# Dockerfile for AA contracts deployment service
FROM ghcr.io/foundry-rs/foundry:latest

# Run as root to avoid permission issues
USER root

# Set working directory
WORKDIR /app

# Copy only the necessary files for aa-contracts build
COPY contracts/aa/ /app/aa-contracts/
COPY contracts/lib/forge-libs/ /app/lib/forge-libs/

# Set working directory to aa-contracts
WORKDIR /app/aa-contracts

# Clean any existing artifacts and cache to avoid permission issues
RUN rm -rf out/ cache/ broadcast/ || true

# Create directories and set permissions
RUN mkdir -p out cache broadcast /shared && \
    chmod 777 out cache broadcast /shared

# Run the deployment script
CMD ["./deploy-docker.sh"]