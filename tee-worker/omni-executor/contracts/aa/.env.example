# ========================================
# AA Contracts Deployment Configuration
# ========================================
# Copy this file to .env and fill in your values

# Required - Network Configuration
PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# ========================================
# Contract Deployment Configuration
# ========================================

# Deploy EntryPointV1 (default: true)
DEPLOY_ENTRYPOINT=true

# Deploy OmniAccountFactoryV1 (default: true)
DEPLOY_FACTORY=true

# Deploy SimplePaymaster (default: true)
DEPLOY_SIMPLE_PAYMASTER=true

# Deploy ERC20PaymasterV1 (default: false)
DEPLOY_ERC20_PAYMASTER=false

# ========================================
# Existing Contract Configuration
# ========================================

# Required when DEPLOY_ENTRYPOINT=false
# Address of existing EntryPoint contract
# ENTRYPOINT_ADDRESS=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789

# ========================================
# Paymaster Configuration
# ========================================

# Initial deposit for paymasters in wei (default: 1 ETH)
PAYMASTER_INITIAL_DEPOSIT=1000000000000000000

# Initial authorized bundler address (default: deployer address)
INITIAL_BUNDLER=0xYOUR_BUNDLER_ADDRESS

# ========================================
# Deployment Management
# ========================================

# Save deployment artifacts to JSON files (default: false)
# Set to true for production deployments
SAVE_DEPLOYMENT_FILE=true

# Deployment environment subdirectory (optional)
# Examples: "staging", "production", "testnet"
DEPLOYMENT_ENV=staging

# ========================================
# Contract Verification (optional)
# ========================================

# Etherscan/block explorer API key for contract verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# ========================================
# Local Development (for DeployLocalWithPaymaster.s.sol)
# ========================================

# Omni Executor signer address (for local testing)
# OMNI_EXECUTOR_SIGNER=0x1234567890abcdef1234567890abcdef12345678

# Paymaster type for local deployment: "simple", "demo", or "erc20"
# PAYMASTER_TYPE=simple