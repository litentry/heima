# ── Deployment ────────────────────────────────────────────────────────────────
# Private key of the deployer EOA (no 0x prefix)
PRIVATE_KEY=

# Arbitrum Sepolia RPC (public endpoint works, or use Alchemy/Infura for reliability)
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ── Contract verification (optional but recommended) ──────────────────────────
# Get from https://arbiscan.io/myapikey
# Forge reads ETHERSCAN_API_KEY by default; deploy.sh passes it via --etherscan-api-key
ETHERSCAN_API_KEY=

# ── Post-deployment (fill in after running forge script) ──────────────────────
# Addresses printed by Deploy.s.sol — copy them here for reference
DEMO_USDC_ADDRESS=
MOCK_VERIFIER_ADDRESS=
PRIVACY_POOL_ADDRESS=

# ── TEE server ────────────────────────────────────────────────────────────────
# Set this on the TEE worker so omni_payInvoice / omni_withdrawFromPool know
# which pool to target. Copy PRIVACY_POOL_ADDRESS here.
OE_PRIVACY_POOL_ADDRESS=
