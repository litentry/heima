{
    "name": "Heima-integration-test",
    "version": "1.0.0",
    "description": "This is a set of integration tests for Heima runtime, using TypeScript.",
    "main": "index.js",
    "directories": {
        "test": "integration-tests"
    },
    "scripts": {
        "register-parathread": "pnpm exec tsx common/setup/register-parathread.ts",
        "skip-schedule-enclave-check": "pnpm exec tsx common/setup/skip-schedule-enclave-check.ts",
        "upgrade-parathread": "pnpm exec tsx common/setup/upgrade-parathread.ts",
        "wait-finalized-block": "pnpm exec tsx common/setup/wait-finalized-block.ts",
        "setup-enclave": "pnpm exec tsx common/setup/setup-enclave.ts",
        "test-filter": "vitest run integration-tests/base-filter.test.ts",
        "test-evm-contract": "vitest run integration-tests/evm-contract.test.ts",
        "test-runtime-upgrade": "vitest run integration-tests/runtime-upgrade.test.ts",
        "test-all": "vitest run integration-tests",
        "test-precompile-contract": "vitest run integration-tests/precompile-contract.test.ts",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "format": "pnpm exec prettier --write '**.ts'"
    },
    "author": "Heima Dev",
    "license": "ISC",
    "devDependencies": {
        "@vitest/ui": "^4.0.11",
        "gts": "^6.0.2",
        "prettier": "^3.6.2",
        "ts-node": "^10.9.2",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "vitest": "^4.0.11"
    },
    "dependencies": {
        "@polkadot/api": "^16.5.2",
        "@polkadot/api-augment": "^16.5.2",
        "@polkadot/keyring": "^13.5.8",
        "@polkadot/types": "^16.5.2",
        "@polkadot/util": "^13.5.8",
        "@polkadot/util-crypto": "^13.5.8",
        "@types/bn.js": "^5.2.0",
        "add": "^2.0.6",
        "bn.js": "^5.2.2",
        "dotenv": "^17.2.3",
        "ethers": "^6.15.0",
        "solc": "^0.8.30",
        "web3": "^4.16.0",
        "web3-types": "^1.10.0",
        "web3-utils": "^4.3.3"
    },
    "type": "module",
    "packageManager": "pnpm@10.21.0",
    "pnpm": {
        "overrides": {
            "elliptic": "6.6.1",
            "ws": "^8.18.2",
            "tmp": ">=0.2.4"
        }
    }
}