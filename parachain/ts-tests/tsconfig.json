{
    "compilerOptions": {
        "esModuleInterop": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "target": "ES2020",
        "lib": ["ES2020"],
        "rootDir": ".",
        "outDir": "build",
        "strict": false,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": [
        "common/**/*.ts",
        "common/**/*.d.ts",
        "integration-tests/**/*.ts",
        "integration-tests/**/*.d.ts",
        "global.d.ts",
        "vitest.config.ts"
    ],
    "exclude": ["node_modules", "build"]
}
