{
    "extends": "./node_modules/gts/tsconfig-google.json",
    "compilerOptions": {
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "target": "ES2020",
        "lib": ["es2020"],
        "rootDir": ".",
        "outDir": "build",
        "skipLibCheck": true
    },
    "include": ["**/*.ts", "**/*.d.ts", "**/*.json"],
    "exclude": ["node_modules"]
}
